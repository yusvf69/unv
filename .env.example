# Database - Required
# Get a free PostgreSQL database from https://neon.tech
# On Vercel: set DATABASE_URL in Project → Settings → Environment Variables (Production/Preview/Development as needed).
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth - Required for API/session signing
# On Vercel: set JWT_SECRET in Project → Settings → Environment Variables (use a long random string; do not commit real secrets).
JWT_SECRET="replace-with-a-long-random-secret"

# AI Chat (optional) - free Gemini API from https://aistudio.google.com/apikey
# On Vercel: set both in Project → Settings → Environment Variables (Production) so the AI assistant works online.
AI_INTEGRATIONS_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_INTEGRATIONS_GEMINI_API_KEY="your-free-gemini-key"

# Local-only AI fallback (optional, ignored on Vercel): free & unlimited, runs on your machine via Ollama.
AI_OLLAMA_BASE_URL="http://localhost:11434"
AI_OLLAMA_MODEL="qwen2.5:7b"

# App
NODE_ENV="development"
PORT=8080
BASE_PATH="/"
